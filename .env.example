# ===================
# Runtime
# ===================
NODE_ENV=development
PORT=4000
WEB_PORT=3000
API_PORT=4000
# Sprint 30 — dev-порт публічної pay-зони. Той самий web-контейнер, другий
# port-mapping: у dev кабінет і pay-зона різняться лише портом, бо cookie-scope
# портами не розділяється (спільна сесія працює), а Google OAuth приймає
# redirect-адресу тільку на `localhost` або публічному TLD. Дублювати цей порт
# ніде не треба: whitelist публічної зони (apps/web/src/shared/config/
# publicHosts.ts) походить від NEXT_PUBLIC_PAY_PUBLIC_URL, тобто від цього ж
# значення. Прод не має цієї змінної: там два справжні хости за nginx.
PAY_PORT=3001

# Кількість довірених reverse-proxy перед API (Express trust proxy).
# 0 — без проксі (XFF ігнорується); 1 — за одним nginx/caddy; і т.д.
# Критично для per-IP rate-limit-ів: див. apps/api/src/config/env.ts.
TRUST_PROXY_HOPS=0

# Shared secret: API → web on-demand revalidation of guides after admin publish.
# Consumed by both containers, MUST be byte-identical in each.
REVALIDATE_SECRET=dev-revalidate-secret

# ===================
# Backend (apps/api)
# ===================
# Cabinet origin (auth, billing, email).
WEB_URL=http://localhost:3000
# Public payment-page origin (host для QR на сторінку бізнесу).
# Sprint 30: у dev — той самий `localhost`, інший порт (PAY_PORT). Вигаданий
# dev-домен (`pay.finly.local`) тут не годиться: Google OAuth не приймає
# redirect-адресу на неіснуючому TLD, і вхід через Google локально відвалюється.
PAY_PUBLIC_URL=http://localhost:3001
# Батьківський домен сесійної cookie: під ним мусять лежати ОБИДВА хости вище
# (fail-fast перевіряє це на старті API). Prod — finly.com.ua, dev — localhost.
# Без схеми, без порту, без провідної крапки.
#
# Порт у цю перевірку не входить і входити не мусить: cookie-scope портами не
# розділяється (RFC 6265 §8.5), тому в dev одна cookie обслуговує обидва порти —
# рівно та поведінка, що в проді між finly.com.ua і pay.finly.com.ua.
AUTH_COOKIE_DOMAIN=localhost

# MUST point at a Mongo replica-set. Standalone mongod is unsupported:
# Sprint 4 cascade-delete (видалення бізнесу разом із його інвойсами) виконується
# у `session.withTransaction`, а Mongo дозволяє транзакції лише на replica-set.
# Atlas dev cluster — replica-set за замовчуванням; для local dev — три варіанти
# у root README.md (секція "Mongo replica-set для local dev"). На standalone
# mongod cascade-delete падає з 500 `CASCADE_DELETE_REQUIRES_REPLICA_SET`.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=<app>

REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=<generate-random-32-byte-hex>
JWT_REFRESH_SECRET=<generate-random-32-byte-hex>

GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

RESEND_API_KEY=re_your_resend_api_key
# Production: verified domain sender (e.g. Finly <no-reply@finly.com.ua>)
RESEND_FROM_EMAIL=Finly <onboarding@resend.dev>

# monobank «Плата» (Sprint 22) — білінг під керуванням нашого billing-clock.
# X-Token із кабінету monobank (тестовий токен — з api.monobank.ua).
MONOBANK_TOKEN=test-monobank-token

# Демо-режим білінгу (демо-банер на сторінці тарифу). На проді з живими грошима — false.
BILLING_DEMO_MODE=true

# --- Google Search Console (органічні кліки на гайди) ---
GSC_SITE_URL=sc-domain:finly.com.ua
GSC_CLIENT_EMAIL=finly-gsc@your-project.iam.gserviceaccount.com
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# --- Cloudflare R2 (media storage) ---
# R2_PUBLIC_URL hostname MUST equal NEXT_PUBLIC_STORAGE_HOSTNAME (below) —
# otherwise next/image rejects uploaded photos at runtime.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=finly-media
R2_PUBLIC_URL=https://media.finly.com.ua

# ===================
# Frontend (apps/web)
# ===================
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Public payment-page origin (host для copy-link і QR на сторінку бізнесу).
# Має збігатись з PAY_PUBLIC_URL на api side (у dev — той самий PAY_PORT).
NEXT_PUBLIC_PAY_PUBLIC_URL=http://localhost:3001

# Демо-банер білінгу (тестова картка monobank, "кошти не списуються").
# Лише для sandbox-стадії. У проді МУСИТЬ бути false.
NEXT_PUBLIC_BILLING_DEMO_MODE=true

# Hostname of the R2 public CDN (MUST match the hostname of R2_PUBLIC_URL above).
NEXT_PUBLIC_STORAGE_HOSTNAME=media.finly.com.ua
